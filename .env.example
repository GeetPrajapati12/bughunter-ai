# ── BugHunter AI — Environment Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.
# Only ONE AI provider section is needed — fill in the one you have.

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose one: anthropic | openai | gemini | groq | ollama | omniroute
AI_PROVIDER=omniroute

# ── AI Model ──────────────────────────────────────────────────────────────────
# Set the model name that matches your chosen provider:
#
#   anthropic  → claude-sonnet-4-6 | claude-opus-4-6 | claude-haiku-4-5-20251001
#   openai     → gpt-4o | gpt-4-turbo | gpt-3.5-turbo
#   gemini     → gemini-1.5-pro | gemini-1.5-flash
#   groq       → openai/gpt-oss-120b | openai/gpt-oss-20b
#   ollama     → llama3 | mistral | phi3 (any model you have pulled locally)
#   omniroute  → auto/best-free | auto/best-coding | claude-sonnet-4-6 | gpt-4o
#                (any model from 231+ providers — use auto/best-free for zero cost)
#
AI_MODEL=auto/best-free
# AI_MAX_TOKENS=4096
# AI_TEMPERATURE=0.2

# ── API Keys ──────────────────────────────────────────────────────────────────
# Only fill in the key for your chosen AI_PROVIDER. Leave others blank.

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq (free tier available) — https://console.groq.com
GROQ_API_KEY=

# Ollama (local, no key needed) — https://ollama.com
# Make sure Ollama is running: ollama serve
# Pull a model first: ollama pull llama3
OLLAMA_BASE_URL=

# ── OmniRoute (free, self-hosted, 231+ providers) ─────────────────────────────
# OmniRoute gives you one endpoint for 231+ AI providers with auto-fallback.
# It aggregates ~1.6B free tokens/month across 40+ free provider pools.
#
# Setup (one-time, requires Node.js):
#   npm install -g omniroute
#   omniroute
#   # Dashboard opens at http://localhost:20128
#
# Or with Docker:
#   docker run -p 20128:20128 diegosouzapw/omniroute
#
# GitHub: https://github.com/diegosouzapw/OmniRoute
#
# The API key is OPTIONAL for free models.
# Leave OMNIROUTE_API_KEY blank to use the free provider pools.
# Add a key only if you want to access paid models through OmniRoute.
OMNIROUTE_API_KEY= here is my key comes
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# ── Browser ───────────────────────────────────────────────────────────────────
BROWSER_ENGINE=selenium          # selenium | playwright
BROWSER_HEADLESS=true
BROWSER_WINDOW_WIDTH=1366
BROWSER_WINDOW_HEIGHT=768
PAGE_LOAD_TIMEOUT=30
IMPLICIT_WAIT=5
ELEMENT_TIMEOUT=10

# ── Crawler ───────────────────────────────────────────────────────────────────
MAX_PAGES=50
MAX_DEPTH=3
CRAWL_DELAY_SECONDS=1.0
RESPECT_ROBOTS_TXT=true

# ── Visual Regression ─────────────────────────────────────────────────────────
# Max % of pixels allowed to change before flagging as a visual regression.
# Raise to 1.0 or 2.0 if you get false positives from animated/dynamic content.
VISUAL_THRESHOLD=0.1

# ── Reporting ─────────────────────────────────────────────────────────────────
REPORT_FORMAT=html               # html | pdf | both
SCREENSHOT_ON_FAIL=true
CAPTURE_VIDEO=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
